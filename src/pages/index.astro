---
import { getImage } from "astro:assets";
import BaseLayout from "@/layouts/BaseLayout.astro";
import Hero from "@/components/Hero.astro";
import ProjectGallery from "@/components/ProjectGallery.astro";
import SectionHeading from "@/components/SectionHeading.astro";
import EntryCard from "@/components/EntryCard.astro";
import ExperienceAccordion from "@/components/react/ExperienceAccordion";
import Footer from "@/components/Footer.astro";
import SkillsGrid from "@/components/react/SkillsGrid";
import { getPortfolioEntries } from "@/lib/portfolioEntries";
import { resolveThumbnail } from "@/lib/images";
import "@/styles/character.css";

const { experience, projects, extras } = await getPortfolioEntries();
const projectCards = await Promise.all(projects.map(async (item) => {
  const asset = resolveThumbnail(item.thumbnail);
  if (!asset) return { ...item, thumbnail: null };
  const image = await getImage({ src: asset, width: 960, format: "webp" });
  return { ...item, thumbnail: image.src };
}));
---

<BaseLayout>
  <main id="main-content" class="character-page">
    <section id="hero-section" aria-labelledby="hero-name"><Hero /></section>
    <div class="character-content">
      <section id="work-section" class="character-section" aria-labelledby="work-heading">
        <SectionHeading id="work-heading" title="Experience" index="01" note="THE EXPERIENCE SO FAR" />
        <ExperienceAccordion client:visible items={experience} />
      </section>
      <section id="project-section" class="character-section" aria-labelledby="project-heading">
        <SectionHeading id="project-heading" title="Projects" index="02" note="IDEAS MADE REAL" />
        <ProjectGallery items={projectCards} />
      </section>
      <section id="extra-section" class="character-section" aria-labelledby="extra-heading">
        <SectionHeading id="extra-heading" title="Beyond work" index="03" note="CURIOSITY TAKES THE LEAD" />
        <ol class="character-extras">{extras.map((entry, index) => <EntryCard entry={entry} index={index} />)}</ol>
      </section>
      <section id="skill-section" class="character-section" aria-labelledby="skill-heading">
        <SectionHeading id="skill-heading" title="The toolkit" index="04" note="TOOLS OF THE TRADE" />
        <SkillsGrid client:visible />
      </section>
    </div>
  </main>
  <Footer />
</BaseLayout>
