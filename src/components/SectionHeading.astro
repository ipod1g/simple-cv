---
interface Props { id: string; title: string; index?: string; note?: string }
const { id, title, index, note } = Astro.props;
---

<div class="chapter-heading reveal">
  <div class="chapter-heading__meta"><span>{index && `/${index}`} {note}</span><span aria-hidden="true">BONO KU / PORTFOLIO</span></div>
  <h2 id={id} class="section-heading"><span>{title}</span><span class="section-heading__arrow" aria-hidden="true">↘</span></h2>
</div>
