---
import { Image } from "astro:assets";
import Monogram from "@/components/Monogram.astro";
import { formatDuration, isoRange, type Entry } from "@/lib/entries";
import { resolveThumbnail } from "@/lib/images";

interface Props {
  entry: Entry;
}

const { entry } = Astro.props;
const { title, subtitle, start, end, url, thumbnail } = entry.data;
const logo = resolveThumbnail(thumbnail);
const Tag = url ? "a" : "div";
---

<li class="reveal">
  <Tag
    class="xp-card"
    {...url
      ? {
          href: url,
          target: "_blank",
          rel: "noreferrer",
          "aria-label": `${title} — ${subtitle ?? "role"} (opens in a new tab)`,
        }
      : {}}
  >
    <h3 class="xp-card__title">{title}</h3>

    <div class="xp-card__logo">
      {
        logo ? (
          <Image
            src={logo}
            alt=""
            width={80}
            height={80}
            loading="lazy"
            class="xp-card__img"
          />
        ) : (
          <Monogram title={title} variant="logo" />
        )
      }
    </div>

    <time class="xp-card__duration" datetime={isoRange(start, end)}>
      {formatDuration(start, end)}
    </time>
    {subtitle && <p class="xp-card__subtitle">{subtitle}</p>}
  </Tag>
</li>

<style>
  .xp-card {
    display: flex;
    flex-direction: column;
    justify-content: center;
    flex-shrink: 0;
    width: 40vw;
    min-width: 240px;
    padding: 2.5rem;
    margin-bottom: 1.5rem;
    color: inherit;
    text-decoration: none;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    transition: background-color 400ms ease, border-color 400ms ease;
  }

  @media (min-width: 1024px) {
    .xp-card {
      max-width: 330px;
    }
  }

  a.xp-card:hover,
  a.xp-card:focus-visible {
    background: var(--color-surface-hover);
    border-color: color-mix(in srgb, var(--color-accent) 45%, transparent);
  }

  .xp-card__title {
    position: relative;
    padding-right: 0.5rem;
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--color-heading);
  }

  .xp-card__title::before {
    content: "";
    position: absolute;
    left: -0.75rem;
    height: 100%;
    width: 1px;
    background: var(--color-rule);
  }

  .xp-card__logo {
    display: flex;
    justify-content: flex-start;
    padding-block: 1.5rem;
  }

  .xp-card__img {
    height: 80px;
    width: 80px;
    object-fit: contain;
  }

  .xp-card__duration {
    display: block;
    font-size: 1rem;
  }

  .xp-card__subtitle {
    font-size: 1rem;
    font-weight: 600;
    color: var(--color-heading);
  }
</style>
