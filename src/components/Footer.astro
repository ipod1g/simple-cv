---
import Icon from "@/components/Icon.astro";
import { SITE, SOCIALS } from "@/config/site";
const year = new Date().getFullYear();
const email = SOCIALS.find(social => social.name === "Email")!;
---

<footer class="character-footer" id="contact-section" aria-labelledby="contact-heading">
  <div class="character-footer__inner">
    <div class="character-footer__top"><p class="character-micro">/05 THE NEXT CHAPTER</p><a href="#hero-section">Back to the menu ↑</a></div>
    <div class="character-footer__invitation">
      <h2 id="contact-heading">Let's build<br /><span>something.</span></h2>
      <a class="character-footer__email" href={email.href} aria-label={`Email ${SITE.name}`}><span aria-hidden="true">↗</span></a>
    </div>
    <nav class="character-footer__socials" aria-label="Get in touch">
      {SOCIALS.map(social => <a href={social.href} target={social.href.startsWith("mailto:") ? undefined : "_blank"} rel="noreferrer">
        <Icon name={social.icon} size={18} /><span>{social.name}</span><span aria-hidden="true">↗</span>
        {!social.href.startsWith("mailto:") && <span class="sr-only"> (opens in a new tab)</span>}
      </a>)}
    </nav>
    <div class="character-footer__bottom"><span>© {year} {SITE.name}</span><span>{SITE.credits}</span><span>PHYSICS MIND. ENGINEER BY CRAFT.</span></div>
  </div>
</footer>

<script>
  const footer = document.querySelector<HTMLElement>(".character-footer");
  if (footer) {
    const measure = () => footer.style.setProperty("--footer-height", `${footer.offsetHeight}px`);
    measure();
    new ResizeObserver(measure).observe(footer);
  }
</script>
