---
import Icon from "@/components/Icon.astro";
import { SITE, SOCIALS } from "@/config/site";

const year = new Date().getFullYear();
---

<footer class="site-footer glass">
  <ul class="site-footer__socials">
    {
      SOCIALS.map((social) => (
        <li>
          <a
            class="site-footer__link"
            href={social.href}
            target={social.href.startsWith("mailto:") ? undefined : "_blank"}
            rel="noreferrer"
            aria-label={
              social.icon === "envelope"
                ? `Email ${SITE.name}`
                : `${SITE.name} on ${social.name} (opens in a new tab)`
            }
          >
            <Icon name={social.icon} size={20} />
          </a>
        </li>
      ))
    }
  </ul>
  <p class="site-footer__legal">© {year} {SITE.name} | All Rights Reserved.</p>
</footer>

<style>
  .site-footer {
    position: fixed;
    bottom: 0;
    z-index: 50;
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 100%;
    padding: 0.75rem 0 0.5rem;
  }

  .site-footer__socials {
    display: flex;
    gap: 1rem;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .site-footer__link {
    display: inline-flex;
    padding: 0.375rem;
    border-radius: 0.375rem;
    color: inherit;
    transition: color 200ms ease;
  }

  .site-footer__link:hover,
  .site-footer__link:focus-visible {
    color: var(--color-accent);
  }

  .site-footer__legal {
    margin-top: 0.25rem;
    font-size: 0.75rem;
    line-height: 1.4;
  }

  @media (min-width: 1024px) {
    .site-footer {
      width: 325px;
      padding-bottom: 1rem;
      border-bottom-right-radius: 1rem;
    }

    /* The profile panel already provides the glass surface on desktop. */
    .site-footer.glass {
      background: transparent;
      border: none;
      box-shadow: none;
      backdrop-filter: none;
    }
  }
</style>
