---
import { Image } from "astro:assets";
import { render } from "astro:content";
import EntryLinks from "@/components/EntryLinks.astro";
import Monogram from "@/components/Monogram.astro";
import EntryDialog from "@/components/EntryDialog.astro";
import { formatDuration, isoRange, type Entry } from "@/lib/entries";
import { resolveThumbnail } from "@/lib/images";

interface Props {
  entry: Entry;
  /** `extra` surfaces the subtitle as a heading and captions the figure. */
  variant?: "project" | "extra";
}

const { entry, variant = "project" } = Astro.props;
const { title, subtitle, start, end, url, github, points, thumbnail } =
  entry.data;

const image = resolveThumbnail(thumbnail);
const hasDetail = entry.body != null && entry.body.trim().length > 0;
const { Content } = hasDetail ? await render(entry) : { Content: null };
const dialogId = `detail-${entry.id}`;
---

<li class="entry reveal">
  <div class="entry__head">
    <h3 class="entry__title">{title}</h3>
    <EntryLinks title={title} url={url} github={github} />
  </div>

  <div class="entry__body">
    <figure class="entry__figure">
      {
        image ? (
          <Image
            src={image}
            alt={`${title} thumbnail`}
            widths={[320, 640]}
            sizes="(min-width: 1280px) 32rem, 90vw"
            loading="lazy"
            class="entry__img"
          />
        ) : (
          <Monogram title={title} />
        )
      }
      {
        variant === "extra" && subtitle && (
          <figcaption class="entry__caption">{subtitle}</figcaption>
        )
      }
    </figure>

    <div class="entry__detail">
      {
        variant === "extra" && (
          <div class="entry__meta">
            {subtitle && <p class="entry__subtitle">{subtitle}</p>}
            <time datetime={isoRange(start, end)}>
              {formatDuration(start, end)}
            </time>
          </div>
        )
      }
      <ul class="entry__points">
        {points.map((point) => <li>{point}</li>)}
      </ul>
    </div>
  </div>

  <div class="entry__foot">
    {
      variant === "project" && (
        <time datetime={isoRange(start, end)}>
          {formatDuration(start, end)}
        </time>
      )
    }
    {
      hasDetail && (
        <button
          type="button"
          class="entry__more"
          data-dialog-open={dialogId}
          aria-haspopup="dialog"
        >
          Read more
          <span class="sr-only"> about {title}</span>
        </button>
      )
    }
  </div>

  {
    hasDetail && Content && (
      <EntryDialog id={dialogId} title={title} image={image}>
        <Content />
      </EntryDialog>
    )
  }
</li>

<style>
  .entry {
    display: flex;
    flex-direction: column;
    padding: 2.5rem;
    margin-bottom: 5rem;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    transition: background-color 600ms ease;
  }

  @media (min-width: 1024px) {
    .entry {
      margin-left: 1.5rem;
    }
  }

  .entry__head {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
  }

  .entry__title {
    position: relative;
    padding-right: 0.5rem;
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--color-heading);
  }

  .entry__title::before {
    content: "";
    position: absolute;
    left: -0.75rem;
    height: 100%;
    width: 1px;
    background: var(--color-rule);
  }

  .entry__body {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    padding-block: 1.5rem;
  }

  @media (min-width: 1280px) {
    .entry__body {
      flex-direction: row;
      gap: 2rem;
    }
  }

  .entry__figure {
    display: flex;
    flex: 1;
    flex-direction: column;
    justify-content: center;
    min-width: 0;
  }

  .entry__img {
    aspect-ratio: 16 / 9;
    max-height: 16rem;
    width: 100%;
    height: auto;
    object-fit: cover;
    object-position: center;
  }

  .entry__caption {
    display: none;
    margin-top: 0.5rem;
    opacity: 0.75;
  }

  @media (min-width: 1280px) {
    .entry__caption {
      display: block;
    }
  }

  .entry__detail {
    flex: 1;
    min-width: 0;
  }

  .entry__meta {
    margin-bottom: 0.5rem;
    color: var(--color-heading);
  }

  .entry__subtitle {
    font-size: 1.25rem;
  }

  .entry__points {
    display: flex;
    flex-direction: column;
    list-style: circle;
    padding-left: 1.25rem;
  }

  .entry__points > li {
    margin-bottom: 1rem;
    font-size: 1rem;
    overflow-wrap: break-word;
  }

  .entry__foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .entry__more {
    margin-left: auto;
    font-size: 1.125rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    color: var(--color-accent-strong);
    background: none;
    border: 0;
    border-radius: 0.25rem;
    cursor: pointer;
    transition: opacity 200ms ease;
  }

  .entry__more:hover {
    opacity: 0.75;
  }
</style>
