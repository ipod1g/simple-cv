---
import { ICON_PATHS, type IconName } from "@/lib/icons";

interface Props {
  name: IconName;
  class?: string;
  size?: number;
}

const { name, class: className = "", size = 16 } = Astro.props;
---

<svg
  class={className}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="currentColor"
  aria-hidden="true"
  focusable="false"
>
  <path d={ICON_PATHS[name]}></path>
</svg>
