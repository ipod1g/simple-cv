---
import { monogram } from "@/lib/entries";

interface Props {
  title: string;
  /** `logo` keeps the square company-logo geometry; `wide` fills a 16/9 figure. */
  variant?: "logo" | "wide";
  class?: string;
}

const { title, variant = "wide", class: className = "" } = Astro.props;
const initials = monogram(title);
---

<div
  class:list={[
    "monogram",
    variant === "logo" ? "monogram--logo" : "monogram--wide",
    className,
  ]}
  role="img"
  aria-label={`${title} placeholder image`}
>
  <span aria-hidden="true">{initials}</span>
</div>

<style>
  .monogram {
    display: grid;
    place-items: center;
    background: color-mix(in srgb, var(--color-accent) 12%, transparent);
    border: 1px solid color-mix(in srgb, var(--color-accent) 30%, transparent);
    color: color-mix(in srgb, var(--color-accent) 85%, currentColor);
    font-weight: 700;
    letter-spacing: 0.12em;
    user-select: none;
  }

  .monogram--logo {
    height: 80px;
    width: 80px;
    border-radius: 9999px;
    font-size: 1.5rem;
  }

  .monogram--wide {
    aspect-ratio: 16 / 9;
    width: 100%;
    max-height: 16rem;
    font-size: 2.25rem;
  }
</style>
