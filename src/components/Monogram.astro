---
interface Props {
  title: string;
  text: string;
  /** `logo` is circular, `wide` is a compact 16/9 figure, and `poster` is display artwork. */
  variant?: "logo" | "wide" | "poster";
  class?: string;
}

const { title, text, variant = "wide", class: className = "" } = Astro.props;
---

<div
  class:list={[
    "monogram",
    `monogram--${variant}`,
    className,
  ]}
  role="img"
  aria-label={`${title} placeholder image`}
>
  <span aria-hidden="true">{text}</span>
</div>

<style>
  .monogram {
    display: grid;
    place-items: center;
    background: color-mix(in srgb, var(--color-accent) 12%, transparent);
    border: 1px solid color-mix(in srgb, var(--color-accent) 30%, transparent);
    color: color-mix(in srgb, var(--color-accent) 85%, currentColor);
    font-weight: 700;
    letter-spacing: 0.12em;
    user-select: none;
  }

  .monogram--logo {
    height: 80px;
    width: 80px;
    border-radius: 9999px;
    font-size: 1.5rem;
  }

  .monogram--wide {
    aspect-ratio: 16 / 9;
    width: 100%;
    max-height: 16rem;
    font-size: 2.25rem;
  }

  .monogram--poster {
    width: 100%;
    min-height: clamp(18rem, 48vw, 32rem);
    font-size: clamp(4.5rem, 13vw, 9rem);
    line-height: 1;
    border-radius: 0.25rem;
  }
</style>
