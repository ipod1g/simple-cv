---
import { Image } from "astro:assets";
import portrait from "@/assets/me_aero_angle.webp";
import { SITE } from "@/config/site";

const chapters = [
  { label: "Work", detail: "The experience so far", href: "#work-section" },
  { label: "Projects", detail: "Things I've put into the world", href: "#project-section" },
  { label: "Beyond", detail: "A little outside the day job", href: "#extra-section" },
  { label: "Skills", detail: "Tools of the trade", href: "#skill-section" },
];
---

<div class="character-hero">
  <header class="character-header">
    <a href="#hero-section" class="character-wordmark" aria-label="Bono, back to top">b<span>·</span>k</a>
    <p class="character-micro">{SITE.role} <span class="character-separator">/</span> Independent mind.</p>
    <a class="character-contact" href="#contact-section">Let's talk <span aria-hidden="true">↗</span></a>
  </header>
  <div class="character-stage">
    <div class="character-backword" aria-hidden="true">BONO</div>
    <div class="character-identity">
      <p class="character-micro">Physics mind. Engineer by craft.</p>
      <h1 id="hero-name">Bono<br />Ku<span class="character-name-dot" aria-hidden="true">●</span></h1>
      <p class="character-name-note">KU BON KWAN / SOFTWARE ENGINEER</p>
    </div>
    <div class="character-portrait">
      <span class="character-portrait__disc" aria-hidden="true"></span>
      <span class="character-portrait__cross" aria-hidden="true">+</span>
      <Image src={portrait} widths={[400, 800]} sizes="(max-width: 700px) 50vw, 35vw" alt={`Aerial portrait of ${SITE.fullName}`} loading="eager" fetchpriority="high" />
      <span class="character-portrait__caption">FIG. 01 — THE HUMAN BEHIND THE CODE</span>
    </div>
    <nav class="character-chapters" aria-label="Explore the portfolio">
      {chapters.map((chapter, index) => <a class="character-chapter" href={chapter.href}>
        <span class="character-chapter__number">0{index + 1}</span>
        <span><strong>{chapter.label}</strong><small>{chapter.detail}</small></span>
        <span class="character-chapter__arrow" aria-hidden="true">↗</span>
      </a>)}
    </nav>
    <div class="character-stage-foot">
      <p>Reliable systems.<br /><span>Unexpected details.</span></p>
      <a class="character-resume" href={SITE.cvUrl} target="_blank" rel="noreferrer">Résumé <span aria-hidden="true">↗</span><span class="sr-only"> (opens in a new tab)</span></a>
      <a href="#work-section" class="character-micro">SELECT A CHAPTER <span aria-hidden="true">↓</span></a>
    </div>
  </div>
  <div class="character-about-line">
    <span class="character-micro">A LITTLE CONTEXT</span>
    <p>{SITE.about[0]}</p><span aria-hidden="true">↙</span>
  </div>
</div>

<a class="chapter-return" href="#hero-section" aria-label="Back to character menu" hidden><span aria-hidden="true">↑</span> Menu</a>

<script>
  const hero = document.getElementById("hero-section");
  const returnLink = document.querySelector<HTMLAnchorElement>(".chapter-return");
  if (hero && returnLink) {
    const observer = new IntersectionObserver(([entry]) => {
      returnLink.hidden = entry.isIntersecting;
    });
    observer.observe(hero);
  }
</script>
