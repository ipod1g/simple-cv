---
import { Image } from "astro:assets";
import selfie from "@/assets/selfie.jpeg";
import Footer from "@/components/Footer.astro";
import Icon from "@/components/Icon.astro";
import ThemeToggle from "@/components/ThemeToggle.astro";
import { SITE } from "@/config/site";
---

<div class="profile">
  <div class="profile__panel glass">
    <div class="profile__toggle">
      <ThemeToggle />
    </div>

    <div class="profile__avatar morphism-inner">
      <Image
        src={selfie}
        alt={`Portrait of ${SITE.fullName}`}
        widths={[128, 256]}
        sizes="160px"
        loading="eager"
        fetchpriority="high"
        class="profile__img"
      />
    </div>

    {/* The hero owns the page <h1>; this is a repeat of the same name. */}
    <p class="profile__name">{SITE.fullName} ({SITE.alias})</p>
    <p class="profile__role">
      {SITE.role}
      <Icon name="react" size={16} class="profile__react" />
    </p>
    <p class="profile__intro">{SITE.intro}</p>

    <p class="profile__origins">
      {
        SITE.origins.map((origin) => (
          <span class="profile__origin">
            <span aria-hidden="true">{origin.emoji}</span>
            <span class="profile__origin-label">{origin.label}</span>
          </span>
        ))
      }
    </p>

    <a
      class="profile__cv morphism-outer"
      href={SITE.cvUrl}
      target="_blank"
      rel="noreferrer"
    >
      View my CV<span class="sr-only"> (opens in a new tab)</span>
    </a>
  </div>

  <Footer />
</div>

<style>
  .profile {
    width: 100%;
  }

  @media (min-width: 1024px) {
    .profile {
      flex-shrink: 0;
      width: 320px;
    }
  }

  .profile__panel {
    padding: 0 1.25rem;
    text-align: center;
    border-bottom-left-radius: 1rem;
    border-bottom-right-radius: 1rem;
  }

  @media (min-width: 1024px) {
    .profile__panel {
      position: fixed;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      height: 100%;
      width: 320px;
      border-top-right-radius: 1rem;
      border-bottom-right-radius: 1rem;
    }
  }

  .profile__toggle {
    position: absolute;
    top: 2rem;
    left: 2rem;
  }

  .profile__avatar {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 160px;
    width: 160px;
    margin: 1.5rem auto;
    background: var(--color-avatar-bg);
    border-radius: 9999px;
    transition: background-color 500ms ease;
  }

  .profile__img {
    height: 100%;
    width: 100%;
    padding: 32px;
    object-fit: contain;
    border-radius: 9999px;
    filter: saturate(0.85);
  }

  .profile__name {
    font-size: 1.125rem;
    color: var(--color-accent-strong);
  }

  .profile__role {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.25rem;
    line-height: 1.5rem;
    color: var(--color-heading);
  }

  .profile__react {
    color: rgb(12 211 218);
  }

  .profile__intro {
    max-width: 280px;
    margin: 1rem auto;
    font-size: 0.8rem;
    font-style: italic;
    line-height: 1.5;
    color: var(--color-muted);
  }

  @media (min-width: 1024px) {
    .profile__intro {
      font-size: 0.7rem;
    }
  }

  .profile__origins {
    display: flex;
    justify-content: center;
    gap: 0.5rem;
    font-size: 1rem;
  }

  .profile__origin-label {
    font-size: 0.75rem;
  }

  .profile__cv {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 3.5rem;
    padding: 1.25rem 1rem;
    margin: 2rem auto;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 2.5px;
    text-transform: uppercase;
    text-decoration: none;
    color: inherit;
    background: var(--color-cv-bg);
    border: 1px solid transparent;
    border-radius: 0.375rem;
    transition: border-color 100ms ease, transform 100ms ease;
  }

  .profile__cv:hover,
  .profile__cv:focus-visible {
    border-color: rgb(238 238 238 / 0.3);
  }

  .profile__cv:active {
    transform: scale(0.99);
  }

  @media (prefers-reduced-motion: reduce) {
    .profile__cv,
    .profile__avatar {
      transition-duration: 1ms;
    }
  }
</style>
